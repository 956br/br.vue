# انسخ هذا الملف إلى .env.local وعبّي القيم الحقيقية (ملف .env.local غير مرفوع بـ git)

# مفاتيح Supabase العامة (تُستخدم بالفرونت لتسجيل الزيارات/الاتصالات فقط — صلاحية إضافة، بدون قراءة)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# مفتاح سري (سيرفر فقط، لصفحة الأدمن) — لا تشاركه ولا تضعه بالفرونت
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# باسورد صفحة /admin
ADMIN_PASSWORD=
